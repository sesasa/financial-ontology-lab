fin:fy2025-management a fin:ManagementExplanation ;
    prov:wasDerivedFrom <https://www.sec.gov/Archives/edgar/data/1045810/000104581025000023/nvda-20250126.htm> ;
    fin:evidenceKind "manually_reviewed_management_paraphrase" ;
    fin:locator "Item 7: Fiscal Year 2025 Summary; Gross Profit and Gross Margin; Liquidity and Capital Resources" ;
    fin:period fin:FY2025 ;
    fin:text "Management attributes growth to demand for Hopper-based AI computing. A larger Data Center revenue share improved gross margin; workforce and development spending increased operating expenses. Higher revenue supported operating cash flow." .

