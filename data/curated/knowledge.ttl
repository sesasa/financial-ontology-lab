fin:fy2026-management a fin:ManagementExplanation ;
    prov:wasDerivedFrom <https://www.sec.gov/Archives/edgar/data/1045810/000104581026000021/nvda-20260125.htm> ;
    fin:evidenceKind "manually_reviewed_management_paraphrase" ;
    fin:locator "Item 7: Fiscal Year 2026 Summary; Gross Profit and Gross Margin; Liquidity and Capital Resources" ;
    fin:period fin:FY2026 ;
    fin:text "Management links revenue growth to AI infrastructure demand. The Blackwell systems transition and H20 inventory charges reduced gross margin. Compensation and infrastructure spending increased operating expenses. Management attributes higher operating cash flow to higher revenue." .

